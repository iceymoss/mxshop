# 复制为 .env 后按需修改（.env 已被 git 忽略）
#
# Server 配置来源：
#   nacos — 读取本目录下 config-debug.yaml / config-por.yaml（bootstrap），再向 Nacos 拉取 data_id 对应 JSON
#   local — 只读本目录下 local-server.yaml（或 MXSHOP_LOCAL_SERVER_CONFIG 指定路径），不连 Nacos
MXSHOP_CONFIG_SOURCE=nacos

# 仅 MXSHOP_CONFIG_SOURCE=nacos 时：选用 bootstrap 文件
# debug -> config-debug.yaml   por -> config-por.yaml
# 不设置时沿用旧逻辑：MXSHOP_DEBUG=true 等价于 debug，否则 por
MXSHOP_NACOS_BOOTSTRAP_PROFILE=debug

# 可选：直接指定 bootstrap 文件名（相对本服务目录）或绝对路径，设置后忽略 MXSHOP_NACOS_BOOTSTRAP_PROFILE
# MXSHOP_BOOTSTRAP_FILE=config-debug.yaml

# 仅 MXSHOP_CONFIG_SOURCE=local 时：全量服务 JSON（相对本服务目录或绝对路径）
MXSHOP_LOCAL_SERVER_CONFIG=local-server.yaml

# 启动时是否执行 GORM AutoMigrate（1 / true / yes / on）。生产环境请谨慎开启。
# MXSHOP_AUTO_MIGRATE=true
